<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:layout_marginLeft="2dp"
    android:layout_marginRight="2dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="#FFFFFF"
    app:strokeWidth="0dp"

    >

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:padding="14dp"

        >

        <FrameLayout
            android:id="@+id/img"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_mp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageView
                android:id="@+id/iconChat1"
                android:layout_marginTop="2dp"
                android:layout_marginLeft="0.5dp"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/mdi_message_outline"/>
        </FrameLayout>

        <TextView
            android:id="@+id/txtDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="2025.01.08"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toEndOf="@id/img"
            app:layout_constraintTop_toTopOf="@id/img"
            app:layout_constraintEnd_toStartOf="@id/badge"/>

        <TextView
            android:id="@+id/txtMeta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="질문 5개 / 소요시간 15분"
            android:textSize="12sp"
            android:textColor="#777777"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toEndOf="@id/img"
            app:layout_constraintTop_toBottomOf="@id/txtDate"
            app:layout_constraintEnd_toStartOf="@id/badge"/>

        <TextView
            android:id="@+id/badge"
            android:layout_width="56dp"
            android:layout_height="26dp"
            android:gravity="center"
            android:text="82점"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="12sp"
            android:background="@drawable/bg_score_badge"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>