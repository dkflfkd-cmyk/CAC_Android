<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_gradient">

    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Career AI Coach"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/groupCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.5"
        android:layout_marginTop="90dp"
        />


    <com.google.android.material.card.MaterialCardView
        android:id="@+id/groupCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        app:cardCornerRadius="18dp"
        app:cardUseCompatPadding="true"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:layout_constraintTop_toBottomOf="@id/txtTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="80dp"
            android:paddingBottom="18dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            >

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardName"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_marginStart="1dp"
                android:layout_marginEnd="1dp"
                app:cardCornerRadius="11dp"
                app:cardElevation="10dp"
                app:cardUseCompatPadding="false"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeWidth="0dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <EditText
                    android:id="@+id/edtName"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:hint="이름(또는 닉네임)"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="#111111"
                    android:textColorHint="#B0B0B0"
                    android:textSize="12sp"
                    android:singleLine="true"/>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMajor"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_marginStart="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="6dp"
                app:cardCornerRadius="11dp"
                app:cardElevation="10dp"
                app:cardUseCompatPadding="false"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeWidth="0dp"
                app:layout_constraintTop_toBottomOf="@id/cardName"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/cardEdu">

                <EditText
                    android:id="@+id/edtMajor"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:hint="학과"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="#111111"
                    android:textColorHint="#B0B0B0"
                    android:textSize="12sp"
                    android:singleLine="true"/>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardEdu"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="1dp"
                app:cardCornerRadius="11dp"
                app:cardElevation="10dp"
                app:cardUseCompatPadding="false"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeWidth="0dp"
                app:layout_constraintTop_toBottomOf="@id/cardName"
                app:layout_constraintStart_toEndOf="@id/cardMajor"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintWidth_percent="0.42">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:boxBackgroundMode="filled"
                    app:endIconMode="dropdown_menu"
                    app:boxBackgroundColor="@android:color/transparent"
                    app:boxStrokeWidth="0dp"
                    app:boxStrokeWidthFocused="0dp"
                    app:boxStrokeColor="@android:color/transparent"
                    app:hintTextColor="#B0B0B0"
                    app:hintEnabled="false"

                    >

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/ddEdu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:hint="학력"
                        android:textColor="#111111"
                        android:textSize="12sp"
                        android:inputType="none"
                        android:background="@null"
                        />
                </com.google.android.material.textfield.TextInputLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCareer"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginStart="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="1dp"
                app:cardCornerRadius="11dp"
                app:cardElevation="10dp"
                app:cardUseCompatPadding="false"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeWidth="0dp"
                app:layout_constraintTop_toBottomOf="@id/cardMajor"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:boxBackgroundMode="filled"
                    app:endIconMode="dropdown_menu"
                    app:boxBackgroundColor="@android:color/transparent"
                    app:boxStrokeWidth="0dp"
                    app:boxStrokeWidthFocused="0dp"
                    app:boxStrokeColor="@android:color/transparent"
                    app:hintTextColor="#B0B0B0"
                    app:hintEnabled="false"

                    >

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/ddCareer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:hint="경력"
                        android:inputType="none"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textColor="#111111"
                        android:textSize="12sp"
                        android:background="@null"

                        />
                </com.google.android.material.textfield.TextInputLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardWish"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginStart="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="1dp"
                app:cardCornerRadius="11dp"
                app:cardElevation="10dp"
                app:cardUseCompatPadding="false"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeWidth="0dp"
                app:layout_constraintTop_toBottomOf="@id/cardCareer"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <EditText
                    android:id="@+id/edtWishJob"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:hint="희망 직무"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="#111111"
                    android:textColorHint="#B0B0B0"
                    android:textSize="12sp"
                    android:singleLine="true"/>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardNext1"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_marginStart="1dp"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="1dp"
                app:cardCornerRadius="11dp"
                app:cardElevation="14dp"
                app:cardUseCompatPadding="false"
                app:cardBackgroundColor="#111111"
                app:strokeWidth="0dp"
                app:layout_constraintTop_toBottomOf="@id/cardWish"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/btnNext1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="회원가입"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true"/>
            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
