<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".InterviewActivity">

    <!-- 상단 흰 배경(타이틀 영역) -->
    <View
        android:id="@+id/titleBg"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:background="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 타이틀 -->
    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="45dp"
        android:textSize="16sp"
        android:textStyle="bold"
        android:text="Career AI Coach"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 서브 타이틀 -->
    <TextView
        android:id="@+id/txtSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:layout_marginTop="6dp"
        android:text="대화형 AI 면접"
        android:textColor="#4C4C4C"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtTitle" />

    <!-- 햄버거 -->
    <ImageButton
        android:id="@+id/btnMenu"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginEnd="20dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/app_name"
        android:padding="0dp"
        android:src="@drawable/group_1"
        app:layout_constraintBottom_toBottomOf="@id/txtTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/txtTitle" />

    <!-- 카드 섹션 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/interviewSection"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingBottom="60dp"
        android:clipToPadding="false"
        android:clipChildren="false"
        app:layout_constraintTop_toBottomOf="@id/titleBg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">







        <!-- 큰 카드 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardInterview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:cardCornerRadius="12dp"
            app:cardElevation="6dp"
            app:strokeColor="#AEB4D9"
            app:strokeWidth="0.4dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="300dp"
                android:padding="18dp"
                android:paddingBottom="60dp"
                android:background="#FFFFFF">

                <!-- 안내 문구 -->


                <TextView
                    android:id="@+id/txtGuide"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="64dp"
                    android:gravity="center"
                    android:text="AI가 이력서 분석 결과를 \n기반으로 채팅형 현실 면접 환경을 생성합니다."
                    android:textColor="#7A7A7A"
                    android:textSize="14sp"
                    android:fontFamily="@font/pretendard_light"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/boxJob"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginLeft="15dp"
                    android:layout_marginRight="15dp"
                    android:layout_marginTop="50dp"
                    android:background="@drawable/bg_input_gray"
                    app:layout_constraintTop_toBottomOf="@id/txtGuide"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">
                    <EditText
                        android:id="@+id/etJobInput"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:hint="희망 직무"
                        android:paddingStart="14dp"
                        android:textSize="12sp"
                        android:inputType="text" />
                </androidx.constraintlayout.widget.ConstraintLayout>


            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 시작 버튼(원형) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/btnStartCircle"
            android:layout_width="105dp"
            android:layout_height="105dp"
            android:layout_marginTop="-42dp"
            android:elevation="30dp"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintTop_toBottomOf="@id/cardInterview"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/startRing"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="55dp"
                app:cardElevation="12dp"
                app:cardUseCompatPadding="false"
                app:strokeWidth="0dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <View
                        android:id="@+id/startInner"
                        android:layout_width="74dp"
                        android:layout_height="74dp"
                        android:background="@drawable/bg_analyze_circle"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/txtStart"
                        android:layout_width="74dp"
                        android:layout_height="74dp"
                        android:gravity="center"
                        android:text="시작"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:layout_constraintTop_toTopOf="@id/startInner"
                        app:layout_constraintBottom_toBottomOf="@id/startInner"
                        app:layout_constraintStart_toStartOf="@id/startInner"
                        app:layout_constraintEnd_toEndOf="@id/startInner" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 하단 탭 -->
    <LinearLayout
        android:id="@+id/bottomTab"
        android:layout_width="0dp"
        android:layout_height="74dp"
        android:background="#FFFFFF"
        android:gravity="top"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/btnNoticeh"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"

            android:text="홈"
            android:textColor="#111111"
            android:textSize="12sp"
            android:textStyle="bold"

            android:clickable="true"
            android:focusable="true"
            android:background="@null"/>


        <TextView
            android:id="@+id/btnresume"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"

            android:text="이력서분석"
            android:textColor="#111111"
            android:textSize="12sp"
            android:textStyle="bold"

            android:clickable="true"
            android:focusable="true"
            android:background="@null"/>


        <TextView
            android:id="@+id/btnNoticev"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"

            android:text="대시보드"
            android:textColor="#111111"
            android:textSize="12sp"
            android:textStyle="bold"

            android:clickable="true"
            android:focusable="true"
            android:background="@null"/>


        <TextView
            android:id="@+id/btnNoticev2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"

            android:text="MY"
            android:textColor="#111111"
            android:textSize="12sp"
            android:textStyle="bold"

            android:clickable="true"
            android:focusable="true"
            android:background="@null"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
