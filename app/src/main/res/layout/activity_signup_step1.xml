<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_gradient">

    <TextView
        android:id="@+id/txtTitle1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Career AI Coach"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/cardArea2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.5"
        android:layout_marginTop="90dp"
        />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardArea2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        app:cardCornerRadius="18dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardElevation="0dp"
        app:cardUseCompatPadding="true"
        app:strokeWidth="0dp"
        app:layout_constraintTop_toBottomOf="@id/txtTitle1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        >

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="80dp"
            android:paddingBottom="18dp"
            android:clipChildren="false"
            android:clipToPadding="false"

            >

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardId2"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_marginStart="1dp"
                android:layout_marginEnd="96dp"
                app:cardCornerRadius="11dp"
                app:cardElevation="10dp"
                app:cardUseCompatPadding="false"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeWidth="0dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"

                >

                <EditText
                    android:id="@+id/edtId2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:hint="아이디"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="#111111"
                    android:textColorHint="#B0B0B0"
                    android:textSize="12sp"
                    android:singleLine="true"/>
            </com.google.android.material.card.MaterialCardView>


            <TextView
                android:id="@+id/txtIdError"
                android:layout_width="0dp"
                android:layout_height="15dp"
                android:layout_marginStart="1dp"
                android:layout_marginEnd="1dp"
                android:layout_marginTop="1dp"
                android:text=""
                android:textColor="#FF4D4D"
                android:textSize="11sp"
                app:layout_constraintTop_toBottomOf="@id/cardId2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCheckId"
                android:layout_width="90dp"
                android:layout_height="45dp"
                android:layout_marginEnd="1dp"
                app:cardCornerRadius="11dp"
                app:cardElevation="10dp"
                app:cardUseCompatPadding="false"
                app:cardBackgroundColor="#6D7DED"
                app:strokeWidth="0dp"
                app:layout_constraintTop_toTopOf="@id/cardId2"
                app:layout_constraintBottom_toBottomOf="@id/cardId2"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/btnCheckId"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="중복확인"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true"/>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPw2"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_marginStart="1dp"
                android:layout_marginTop="27dp"
                android:layout_marginEnd="1dp"
                app:cardCornerRadius="11dp"
                app:cardElevation="10dp"
                app:cardUseCompatPadding="false"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeWidth="0dp"
                app:layout_constraintTop_toBottomOf="@id/cardId2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <EditText
                    android:id="@+id/edtPw2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:hint="비밀번호(8자 이상)"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="#111111"
                    android:textColorHint="#B0B0B0"
                    android:textSize="12sp"
                    android:singleLine="true"
                    android:inputType="textPassword"/>



            </com.google.android.material.card.MaterialCardView>



            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPwCheck2"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_marginStart="1dp"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="1dp"
                app:cardCornerRadius="11dp"
                app:cardElevation="10dp"
                app:cardUseCompatPadding="false"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeWidth="0dp"
                app:layout_constraintTop_toBottomOf="@id/cardPw2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <EditText
                    android:id="@+id/edtPwCheck2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:hint="비밀번호 확인"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="#111111"
                    android:textColorHint="#B0B0B0"
                    android:textSize="12sp"
                    android:singleLine="true"
                    android:inputType="textPassword"/>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/txtPwError"
                android:layout_width="0dp"
                android:layout_height="15dp"
                android:layout_marginStart="1dp"
                android:layout_marginEnd="1dp"
                android:layout_marginTop="1dp"
                android:text=""
                android:textColor="#FF4D4D"
                android:textSize="11sp"
                app:layout_constraintTop_toBottomOf="@id/cardPwCheck2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardEmail2"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_marginStart="1dp"
                android:layout_marginTop="15dp"
                android:layout_marginEnd="96dp"
                app:cardCornerRadius="11dp"
                app:cardElevation="10dp"
                app:cardUseCompatPadding="false"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeWidth="0dp"
                app:layout_constraintTop_toBottomOf="@id/txtPwError"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <EditText
                    android:id="@+id/edtEmail2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:hint="이메일"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="#111111"
                    android:textColorHint="#B0B0B0"
                    android:textSize="12sp"
                    android:singleLine="true"
                    android:inputType="textEmailAddress"/>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCheckEmail"
                android:layout_width="90dp"
                android:layout_height="45dp"
                android:layout_marginEnd="1dp"
                app:cardCornerRadius="11dp"
                app:cardElevation="10dp"
                app:cardUseCompatPadding="false"
                app:cardBackgroundColor="#6D7DED"
                app:strokeWidth="0dp"
                app:layout_constraintTop_toTopOf="@id/cardEmail2"
                app:layout_constraintBottom_toBottomOf="@id/cardEmail2"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/btnCheckEmail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="중복확인"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true"/>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/txtEmailError"
                android:layout_width="0dp"
                android:layout_height="15dp"
                android:layout_marginStart="1dp"
                android:layout_marginTop="1dp"
                android:layout_marginEnd="1dp"
                android:text=""
                android:textColor="#FF4D4D"
                android:textSize="11sp"
                app:layout_constraintTop_toBottomOf="@id/cardEmail2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSubmit"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_marginStart="1dp"
                android:layout_marginTop="26dp"
                android:layout_marginEnd="1dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="14dp"
                app:cardUseCompatPadding="false"
                app:cardBackgroundColor="#111111"
                app:strokeWidth="0dp"
                app:layout_constraintTop_toBottomOf="@id/txtEmailError"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/btnSubmit"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="다음"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true"/>
            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
