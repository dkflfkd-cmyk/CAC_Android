<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".MYActivity">


    <TextView
        android:id="@+id/txtTitletest"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginStart="20dp"
        android:layout_marginTop="45dp"
        android:text=""
        tools:text="Career AI Coach"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>


    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginStart="20dp"
        android:layout_marginTop="45dp"
        android:text=""
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/txtSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="마이페이지"
        android:textSize="12sp"
        android:textColor="#4C4C4C"
        android:layout_marginStart="22dp"
        android:layout_marginTop="6dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtTitle"/>



    <ImageButton
        android:id="@+id/btnMenu"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginEnd="20dp"
        android:src="@drawable/group_1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="0dp"
        android:contentDescription="@string/app_name"
        app:layout_constraintBottom_toBottomOf="@id/txtTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/txtTitle" />


    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:layout_marginTop="30dp"
        app:layout_constraintTop_toTopOf="@+id/txtSubtitle"
        app:layout_constraintBottom_toTopOf="@+id/bottomTab"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp">

            <TextView
                android:id="@+id/txtName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="홍길동"
                android:textSize="25sp"
                android:textStyle="bold"
                android:textColor="#3950E7"
                android:layout_marginTop="26dp"
                android:layout_marginLeft="7dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>

            <TextView
                android:id="@+id/btnEdit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="7dp"
                android:text="수정"
                android:textColor="#787878"
                android:textSize="14sp"
                app:layout_constraintBaseline_toBaselineOf="@id/txtName"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- 현재 상태 카드 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="4dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E4E4E4"
                android:backgroundTint="#FFFFFF"
                app:layout_constraintTop_toBottomOf="@id/txtName"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp"
                    >

                    <TextView
                        android:id="@+id/txtStatusTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="현재 상태"
                        android:textStyle="bold"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <TextView
                        android:id="@+id/txtStatus1"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_marginTop="12dp"
                        android:textColor="#FFFFFF"
                        android:gravity="center"
                        android:padding="10dp"
                        android:background="@drawable/bg_score_gradient"
                        android:maxLines="2"
                        android:ellipsize="end"
                        app:layout_constraintTop_toBottomOf="@id/txtStatusTitle"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/txtStatus2" />

                    <TextView
                        android:id="@+id/txtStatus2"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:textColor="#FFFFFF"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:padding="10dp"
                        android:background="@drawable/bg_score_gradient"
                        android:maxLines="2"
                        android:ellipsize="end"
                        app:layout_constraintTop_toBottomOf="@id/txtStatusTitle"
                        app:layout_constraintStart_toEndOf="@id/txtStatus1"
                        app:layout_constraintEnd_toStartOf="@id/txtStatus3"
                        app:layout_constraintHorizontal_chainStyle="spread" />

                    <TextView
                        android:id="@+id/txtStatus3"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:textColor="#FFFFFF"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:padding="10dp"
                        android:background="@drawable/bg_score_gradient"
                        android:maxLines="2"
                        android:ellipsize="end"
                        app:layout_constraintTop_toBottomOf="@id/txtStatusTitle"
                        app:layout_constraintStart_toEndOf="@id/txtStatus2"
                        app:layout_constraintEnd_toEndOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 최근 면접 기록 -->
            <TextView
                android:layout_marginLeft="7dp"
                android:id="@+id/txtInterviewTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="최근 면접 기록"
                android:textStyle="bold"
                android:layout_marginTop="50dp"
                app:layout_constraintTop_toBottomOf="@id/cardStatus"
                app:layout_constraintStart_toStartOf="parent"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvInterview"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintHeight_default="wrap"
                android:nestedScrollingEnabled="false"
                app:layout_constraintTop_toBottomOf="@id/txtInterviewTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:clipToPadding="false"
                android:paddingBottom="12dp"
                />

            <TextView
                android:id="@+id/btnInterviewAll"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="전체 기록 보기 →"
                android:background="@drawable/bg_btn_black_round"
                android:textColor="@android:color/white"
                app:layout_constraintTop_toBottomOf="@id/rvInterview"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />

            <!-- 최근 이력서 분석 -->
            <TextView
                android:id="@+id/txtResumeTitle"
                android:layout_marginLeft="7dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="최근 이력서 분석"
                android:textStyle="bold"
                android:layout_marginTop="50dp"
                app:layout_constraintTop_toBottomOf="@id/btnInterviewAll"
                app:layout_constraintStart_toStartOf="parent"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvResume"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintHeight_default="wrap"
                android:nestedScrollingEnabled="false"
                app:layout_constraintTop_toBottomOf="@id/txtResumeTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:clipToPadding="false"
                android:paddingBottom="12dp"
                />

            <TextView
                android:id="@+id/btnResumeAll"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="전체 기록 보기 →"
                android:background="@drawable/bg_btn_black_round"
                android:textColor="@android:color/white"
                app:layout_constraintTop_toBottomOf="@id/rvResume"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>



            <TextView
                android:id="@+id/txtSavedQuestionsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="7dp"
                android:layout_marginTop="50dp"
                android:text="질문 리스트"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/btnResumeAll"
                app:layout_constraintStart_toStartOf="parent"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSavedQuestions"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintTop_toBottomOf="@id/txtSavedQuestionsTitle"
                app:layout_constraintBottom_toTopOf="@id/btnSavedQuestionsAll"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:nestedScrollingEnabled="false"
                android:clipToPadding="false"
                android:paddingBottom="12dp"
                android:visibility="visible" />

            <TextView
                android:id="@+id/txtEmptyView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="30dp"
                android:gravity="center"
                android:text="저장된 질문이 없습니다."
                android:textColor="#888888"
                android:textSize="14sp"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/txtSavedQuestionsTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/btnSavedQuestionsAll"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:gravity="center"
                android:text="저장된 질문 리스트 →"
                android:background="@drawable/bg_btn_black_round"
                android:textColor="@android:color/white"

                app:layout_constraintTop_toBottomOf="@id/txtEmptyView"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>




    <!-- 하단 탭 -->
    <LinearLayout
        android:id="@+id/bottomTab"
        android:layout_width="0dp"
        android:layout_height="74dp"
        android:background="#FFFFFF"
        android:gravity="top"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/btnNoticeh"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"

            android:text="홈"
            android:textColor="#111111"
            android:textSize="12sp"
            android:textStyle="bold"

            android:clickable="true"
            android:focusable="true"
            android:background="@null"/>


        <TextView
            android:id="@+id/btnInterview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"

            android:text="AI면접"
            android:textColor="#111111"
            android:textSize="12sp"
            android:textStyle="bold"

            android:clickable="true"
            android:focusable="true"
            android:background="@null"/>


        <TextView
            android:id="@+id/btnNoticev"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"

            android:text="대시보드"
            android:textColor="#111111"
            android:textSize="12sp"
            android:textStyle="bold"

            android:clickable="true"
            android:focusable="true"
            android:background="@null"/>


        <TextView
            android:id="@+id/btnNoticev2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"

            android:text="MY"
            android:textColor="#111111"
            android:textSize="12sp"
            android:textStyle="bold"

            android:clickable="true"
            android:focusable="true"
            android:background="@null"/>

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>