<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".cardResumeActivity">

    <View
        android:id="@+id/titleBg"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:background="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/txtTitletest"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="45dp"
        android:text=""
        android:textSize="16sp"
        android:textStyle="bold"
        tools:text="Career AI Coach"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="45dp"
        android:text=""
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@id/titleBg"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txtSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:layout_marginTop="6dp"
        android:text="이력서/자소서 분석"
        android:textColor="#4C4C4C"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtTitle" />

    <ImageButton
        android:id="@+id/btnMenu"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginEnd="20dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/app_name"
        android:padding="0dp"
        android:src="@drawable/group_1"
        app:layout_constraintBottom_toBottomOf="@id/txtTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/txtTitle" />

    <!-- 스크롤 영역 -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:clipToPadding="false"
        android:paddingBottom="90dp"
        app:layout_constraintTop_toBottomOf="@id/titleBg"
        app:layout_constraintBottom_toTopOf="@id/bottomTab"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/contentWrap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- 업로드 섹션 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/uploadSection"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:paddingBottom="50dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardUpload"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="200dp"
                    android:paddingBottom="50dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="6dp"
                    app:strokeColor="#AEB4D9"
                    app:strokeWidth="0dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="250dp"
                        android:background="#FFFFFF"
                        android:padding="18dp">

                        <ImageView
                            android:id="@+id/icDoc"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginTop="11dp"
                            android:src="@drawable/ic_doc"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/txtUploadTitle"
                            android:layout_width="128dp"
                            android:layout_height="22dp"
                            android:layout_marginStart="8dp"
                            android:text="이력서/자소서 첨부"
                            android:textColor="#111111"
                            android:textSize="12sp"
                            app:layout_constraintStart_toEndOf="@id/icDoc"
                            app:layout_constraintTop_toTopOf="@id/icDoc" />

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/fileRow"
                            android:layout_width="0dp"
                            android:layout_height="60dp"
                            android:layout_marginTop="50dp"
                            android:background="@drawable/bg_file_item"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:visibility="gone"
                            app:layout_constraintBottom_toTopOf="@id/btnPickFile"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/txtUploadTitle"
                            app:layout_goneMarginTop="14dp">

                            <ImageView
                                android:id="@+id/icFile"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_file"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <TextView
                                android:id="@+id/txtFileName"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="11dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="2026_이력서.pdf"
                                android:textColor="#111111"
                                android:textSize="12sp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toStartOf="@id/btnRemoveFile"
                                app:layout_constraintStart_toEndOf="@id/icFile"
                                app:layout_constraintTop_toTopOf="parent" />

                            <ImageButton
                                android:id="@+id/btnRemoveFile"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@android:color/transparent"
                                android:src="@drawable/ic_close"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:tint="#666666" />
                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPickFile"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_marginTop="50dp"
                            android:text="이력서 파일 선택"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            app:backgroundTint="#111111"
                            app:cornerRadius="10dp"
                            app:icon="@drawable/ic_upload"
                            app:iconPadding="0dp"
                            app:iconSize="28dp"
                            app:iconTint="#FFFFFF"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/fileRow" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnformdownload"
                            android:layout_width="120dp"
                            android:layout_height="40dp"
                            android:layout_marginTop="1dp"
                            android:text="양식 다운로드"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            app:backgroundTint="#3950E7"
                            app:cornerRadius="30dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- AI 분석 버튼 -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/btnAnalyzeCircle"
                    android:layout_width="105dp"
                    android:layout_height="105dp"
                    android:layout_marginTop="-37dp"
                    android:clickable="true"
                    android:elevation="30dp"
                    app:layout_constraintTop_toBottomOf="@id/cardUpload"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/analyzeRing"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardCornerRadius="55dp"
                        app:cardElevation="12dp"
                        app:cardUseCompatPadding="false"
                        app:strokeWidth="0dp">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <View
                                android:id="@+id/analyzeInner"
                                android:layout_width="74dp"
                                android:layout_height="74dp"
                                android:background="@drawable/bg_analyze_circle"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toEndOf="parent" />

                            <TextView
                                android:id="@+id/btnAnalyze"
                                android:layout_width="74dp"
                                android:layout_height="74dp"
                                android:gravity="center"
                                android:text="AI분석"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                app:layout_constraintTop_toTopOf="@id/analyzeInner"
                                app:layout_constraintBottom_toBottomOf="@id/analyzeInner"
                                app:layout_constraintStart_toStartOf="@id/analyzeInner"
                                app:layout_constraintEnd_toEndOf="@id/analyzeInner" />
                        </androidx.constraintlayout.widget.ConstraintLayout>

                    </com.google.android.material.card.MaterialCardView>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- 결과 섹션 -->
            <LinearLayout
                android:id="@+id/resultSection"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="vertical"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:paddingBottom="24dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:visibility="gone"
                tools:visibility="visible"
                app:layout_constraintTop_toBottomOf="@id/uploadSection"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/txtResult"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:visibility="gone" />

                <!-- 종합 분석 결과 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardScore"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="160dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="8dp"
                    app:cardUseCompatPadding="true"
                    android:backgroundTint="#FFFFFF"
                    app:strokeWidth="0dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:padding="18dp">

                        <TextView
                            android:id="@+id/txtScoreTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="종합 분석 결과"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:textColor="#111111"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="parent" />

                        <LinearLayout
                            android:id="@+id/scoreRow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            app:layout_constraintTop_toBottomOf="@id/txtScoreTitle"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            android:layout_marginTop="1dp"
                            android:layout_marginLeft="20dp"
                            >

                            <TextView
                                android:id="@+id/txtScore"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="85"
                                android:textSize="70sp"
                                android:textStyle="bold"
                                android:textColor="#3950E7" />

                            <TextView
                                android:id="@+id/txtScoreSuffix"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="/100점"
                                android:textSize="18sp"
                                android:layout_marginTop="14dp"
                                android:textColor="#777777" />
                        </LinearLayout>

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 추출된 스킬 및 역량  -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardExtracted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="8dp"
                    app:cardUseCompatPadding="true"
                    android:backgroundTint="#FFFFFF"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/txtExtractedTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="추출된 스킬 및 역량"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:textColor="#111111" />

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chipGroupExtracted"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            app:chipSpacingHorizontal="9dp"
                            app:chipSpacingVertical="2dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 희망 직무 요구 역량 (카드로 감싸기) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardRequired"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="8dp"
                    app:cardUseCompatPadding="true"
                    android:backgroundTint="#FFFFFF"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/txtRequiredTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="희망 직무 요구 역량"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:textColor="#111111" />

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chipGroupRequired"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            app:chipSpacingHorizontal="9dp"
                            app:chipSpacingVertical="2dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 강점 (카드) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardStrength"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="8dp"
                    app:cardUseCompatPadding="true"
                    android:backgroundTint="#FFFFFF"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/txtStrengthTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="강점"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:textColor="#111111" />

                        <LinearLayout
                            android:id="@+id/strengthList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="vertical" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 개선 제안 (카드) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardImprove"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="8dp"
                    app:cardUseCompatPadding="true"
                    android:backgroundTint="#FFFFFF"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/txtImproveTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="개선 제안"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:textColor="#111111" />

                        <LinearLayout
                            android:id="@+id/improveList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="vertical" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>


                <com.google.android.material.button.MaterialButton

                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:id="@+id/btnRoadmap"
                    android:layout_marginTop="20dp"
                    android:text="대시보드 보기 →"
                    android:textSize="15dp"
                    android:textColor="#FFFFFF"
                    app:cornerRadius="10dp"
                    android:backgroundTint="#111111"
                    android:layout_marginLeft="9dp"
                    android:layout_marginRight="9dp"
                    />

            </LinearLayout>



        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 하단 탭 -->
    <LinearLayout
        android:id="@+id/bottomTab"
        android:layout_width="0dp"
        android:layout_height="74dp"
        android:background="#FFFFFF"
        android:gravity="top"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/btnNoticeh"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="홈"
            android:textColor="#111111"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnNoticej"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="공고"
            android:textColor="#111111"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnNoticev"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="대시보드"
            android:textColor="#111111"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnNoticev2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="MY"
            android:textColor="#111111"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>